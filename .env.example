# ============================================================================
# PRAMAN NETWORK — Environment Variables Reference
# ----------------------------------------------------------------------------
# This monorepo is split into several apps. Environment variables are loaded
# per-app (Vite loads from `apps/web/.env`, Node from `apps/auth/.env`).
#
# To get started locally:
#   1. cp .env.example .env
#   2. Copy the relevant keys into the matching app's `.env` file
#      (apps/web/.env, apps/auth/.env)
#   3. Fill in real values from Supabase / Resend / Web3Forms / Pinata.
#
# Never commit real `.env` files. Only `.env.example` is committed.
# ============================================================================

# ----------------------------------------------------------------------------
# WEB APP (apps/web/.env) — prefixed with VITE_, exposed to the browser
# ----------------------------------------------------------------------------

# Supabase project URL & anon public key (for client-side Supabase usage)
# https://supabase.com/dashboard/project/<id>/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the auth/backend service (used by the newsletter subscribe form).
# Defaults to http://localhost:5050 when unset.
VITE_AUTH_API_URL=http://localhost:5050

# Web3Forms access key for the contact form (https://web3forms.com/)
VITE_WEB3FORMS_ACCESS_KEY=

# Deployed ZK Face-Registry verifier contract address (Polygon Amoy),
# shown on the Dashboard. Defaults to a sample address when unset.
VITE_VERIFIER_CONTRACT_ADDRESS=0x71C7656EC7ab88b098defB751B7401B5f6d8976F

# ----------------------------------------------------------------------------
# AUTH SERVICE (apps/auth/.env) — Node/Express backend, keep secret
# ----------------------------------------------------------------------------

# Supabase project URL & SERVICE ROLE key (server-side, full access).
# NEVER expose the service role key to the browser.
# `SUPABASE_SERVICE_KEY` is accepted as an alias.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend API key — sends the welcome email on newsletter signup
# https://resend.com/api-keys
RESEND_API_KEY=

# ----------------------------------------------------------------------------
# NEWSLETTER BROADCAST (scripts/ — CI: .github/workflows/broadcast-newsletter.yml)
# Same three variables used by the auth service.
# ----------------------------------------------------------------------------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=

# ----------------------------------------------------------------------------
# PRAMAN SDK (packages/sdk) — consumed at build time by the web app
# ----------------------------------------------------------------------------

# Gateway / relayer base URL. Falls back to https://gate.praman.network.
# Either works; VITE_* is used by Vite builds, NEXT_PUBLIC_* by Next.js.
# VITE_GATEWAY_URL=https://gate.praman.network
# NEXT_PUBLIC_GATEWAY_URL=https://gate.praman.network
# VITE_BACKEND_URL=
# NEXT_PUBLIC_API_URL=

# Dev-only toggle: bypass Lit Protocol and use client-side wallet-signature
# AES-GCM encryption instead. Set to "true" only for local development/testing.
VITE_BYPASS_LIT=false

# Pinata JWT for uploading encrypted payloads to IPFS
# (VITE_PINATA_JWT / PINATA_API_KEY are accepted aliases).
VITE_PINATA_JWT=
# PINATA_JWT=
# PINATA_API_KEY=

# Optional SDK keys (see packages/sdk/README.md)
# NEXT_PUBLIC_PRAMAN_API_KEY=
# NEXT_PUBLIC_PRAMAN_BACKEND_URL=
